{
  "singleQuote": true,
  "printWidth": 120,
  "arrowParens": "always",
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "studio/src/bifrost/common/EditorAreaManager.ts"
  ],
  "sortImports": {
    "ignoreCase": false,
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": [
          "react"
        ]
      },
      {
        "groupName": "elraptorus",
        "elementNamePattern": [
          "@elraptorus/**"
        ]
      }
    ],
    "groups": [
      [
        "builtin",
        "external",
        "internal",
        "subpath",
        "unknown"
      ],
      "react",
      "elraptorus",
      [
        "parent",
        "sibling",
        "index"
      ]
    ]
  }
}
