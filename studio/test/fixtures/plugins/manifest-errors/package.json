{
  "name": "manifest-errors",
  "displayName": "Manifest Errors",
  "description": "Tests manifest validation error handling. Has structural errors that must prevent loading.",
  "version": "1.0.0",
  "author": "Bifrost Forge World Tests",
  "main": "index.js",
  "bifrostStudio": {
    "contributes": {
      "panes": [
        {
          "id": "leftWithoutPages",
          "title": "Left pane without pages",
          "area": "left"
        }
      ],
      "editorDocumentTypes": [
        {
          "id": "withoutPage",
          "displayName": "No Page",
          "icon": "ph ph-warning",
          "uriPattern": "\\.nopage$"
        }
      ],
      "paneToggles": [
        {
          "id": "removedToggle",
          "icon": "ph ph-warning",
          "tooltip": "Removed",
          "paneAreaId": "left",
          "paneId": "leftWithoutPages"
        }
      ],
      "commands": [
        {
          "title": "Missing ID command"
        },
        {
          "id": "manifestErrors.valid",
          "title": "This one is valid but won't matter"
        }
      ],
      "keybindings": [
        {
          "command": "manifestErrors.badWhen",
          "key": "ctrl+shift+f10",
          "when": "invalidCondition"
        }
      ]
    }
  }
}
