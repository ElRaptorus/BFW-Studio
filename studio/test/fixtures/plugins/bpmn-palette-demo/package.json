{
  "name": "bpmn-palette-demo",
  "version": "2.0.0",
  "displayName": "BPMN Palette & Modeling Demo",
  "description": "Fixture plugin demonstrating palette, context pad, and modeling API usage.",
  "main": "index.js",
  "bifrostStudio": {
    "apiVersion": "1.0.0",
    "displayName": "BPMN Palette & Modeling Demo",
    "permissions": [
      "bpmn.modelling"
    ],
    "activationEvents": [
      "onDocumentType:bpmn"
    ],
    "contributes": {
      "commands": [
        {
          "id": "runAnalysis",
          "title": "Run Analysis"
        },
        {
          "id": "inspectElement",
          "title": "Inspect Element"
        },
        {
          "id": "insertTaskTemplate",
          "title": "Insert Task Template"
        },
        {
          "id": "renameElement",
          "title": "Rename Element"
        },
        {
          "id": "deleteElement",
          "title": "Delete Element"
        },
        {
          "id": "nudgeRight",
          "title": "Nudge Right"
        },
        {
          "id": "toggleFlag",
          "title": "Toggle Flag"
        },
        {
          "id": "viewConnections",
          "title": "View Connections"
        },
        {
          "id": "updateViewConnectionsFilter",
          "title": "Update View Connections Filter"
        },
        {
          "id": "test.isActivated",
          "title": "Test: Is Activated"
        },
        {
          "id": "test.tryUnregisterContextPadEntry",
          "title": "Test: Unregister Context Pad"
        },
        {
          "id": "test.tryUnregisterPaletteEntry",
          "title": "Test: Unregister Palette"
        },
        {
          "id": "test.updateContextPadEntry",
          "title": "Test: Update Context Pad"
        },
        {
          "id": "test.modeling.updateProperties",
          "title": "Test: updateProperties"
        },
        {
          "id": "test.modeling.removeElement",
          "title": "Test: removeElement"
        },
        {
          "id": "test.modeling.appendElement",
          "title": "Test: appendElement"
        },
        {
          "id": "test.modeling.createConnection",
          "title": "Test: createConnection"
        },
        {
          "id": "test.modeling.moveElement",
          "title": "Test: moveElement"
        }
      ],
      "bpmnPalette": [
        {
          "id": "run-analysis",
          "icon": "ph-light ph-magnifying-glass",
          "title": "Run Analysis",
          "command": "runAnalysis"
        },
        {
          "id": "insert-task-template",
          "icon": "ph-light ph-plus-circle",
          "title": "Insert Service Task",
          "command": "insertTaskTemplate",
          "group": "modeling"
        }
      ],
      "bpmnContextPad": [
        {
          "id": "inspect-element",
          "icon": "ph-light ph-info",
          "title": "Inspect Element",
          "command": "inspectElement",
          "elementTypes": [
            "bpmn:Task",
            "bpmn:SubProcess",
            "bpmn:ServiceTask",
            "bpmn:UserTask",
            "bpmn:ScriptTask"
          ]
        }
      ]
    }
  }
}
