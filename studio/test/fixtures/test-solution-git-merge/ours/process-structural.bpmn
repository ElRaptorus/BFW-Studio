<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bfw="https://bifrostforge.world/schema/bpmn" id="Definitions_Structural" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Structural" name="Structural Process" isExecutable="true">
    <bpmn:startEvent id="Start_1">
      <bpmn:outgoing>Flow_ToGw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_1" name="Decision">
      <bpmn:incoming>Flow_ToGw</bpmn:incoming>
      <bpmn:outgoing>Flow_ToA</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToB</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToC</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="TaskA" name="Task Alpha Renamed">
      <bpmn:incoming>Flow_ToA</bpmn:incoming>
      <bpmn:outgoing>Flow_AEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="TaskB" name="Task Beta">
      <bpmn:incoming>Flow_ToB</bpmn:incoming>
      <bpmn:outgoing>Flow_BEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="TaskC" name="Task Gamma">
      <bpmn:incoming>Flow_ToC</bpmn:incoming>
      <bpmn:outgoing>Flow_CEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_1">
      <bpmn:incoming>Flow_AEnd</bpmn:incoming>
      <bpmn:incoming>Flow_BEnd</bpmn:incoming>
      <bpmn:incoming>Flow_CEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToGw" sourceRef="Start_1" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_ToA" sourceRef="Gateway_1" targetRef="TaskA" />
    <bpmn:sequenceFlow id="Flow_ToB" sourceRef="Gateway_1" targetRef="TaskB" />
    <bpmn:sequenceFlow id="Flow_ToC" sourceRef="Gateway_1" targetRef="TaskC" />
    <bpmn:sequenceFlow id="Flow_AEnd" sourceRef="TaskA" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_BEnd" sourceRef="TaskB" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_CEnd" sourceRef="TaskC" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Structural">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="179" y="219" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true">
        <dc:Bounds x="275" y="212" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskA_di" bpmnElement="TaskA">
        <dc:Bounds x="390" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskB_di" bpmnElement="TaskB">
        <dc:Bounds x="390" y="197" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskC_di" bpmnElement="TaskC">
        <dc:Bounds x="390" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1">
        <dc:Bounds x="562" y="219" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToGw_di" bpmnElement="Flow_ToGw">
        <di:waypoint x="215" y="237" />
        <di:waypoint x="275" y="237" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToA_di" bpmnElement="Flow_ToA">
        <di:waypoint x="300" y="212" />
        <di:waypoint x="300" y="117" />
        <di:waypoint x="390" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToB_di" bpmnElement="Flow_ToB">
        <di:waypoint x="325" y="237" />
        <di:waypoint x="390" y="237" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToC_di" bpmnElement="Flow_ToC">
        <di:waypoint x="300" y="262" />
        <di:waypoint x="300" y="360" />
        <di:waypoint x="390" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AEnd_di" bpmnElement="Flow_AEnd">
        <di:waypoint x="490" y="117" />
        <di:waypoint x="562" y="237" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BEnd_di" bpmnElement="Flow_BEnd">
        <di:waypoint x="490" y="237" />
        <di:waypoint x="562" y="237" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CEnd_di" bpmnElement="Flow_CEnd">
        <di:waypoint x="490" y="360" />
        <di:waypoint x="562" y="237" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
