<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bfw="https://bifrostforge.world/schema/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="order-process_Definition" targetNamespace="https://bifrostforge.world/schema/bpmn">
  <bpmn:extensionElements>
    <bfw:properties>
      <bfw:linterRulesetScore rulesetId="bpmn-production-ready" scorePercent="88.88888888888889" complianceStatus="risky" computedAtIso="2026-09-23T20:07:43.380Z" schemaVersion="1" maxPoints="9" penaltyPoints="1" rawErrorFindings="0" rawWarningFindings="2" />
      <bfw:linterRulesetScore rulesetId="bpmn-development" scorePercent="100" complianceStatus="valid" computedAtIso="2026-09-23T20:07:51.397Z" schemaVersion="1" maxPoints="9" penaltyPoints="0" rawErrorFindings="0" rawWarningFindings="0" />
    </bfw:properties>
  </bpmn:extensionElements>
  <bpmn:collaboration id="Collaboration_order">
    <bpmn:participant id="Participant_order" name="Order" processRef="order-process" />
  </bpmn:collaboration>
  <bpmn:process id="order-process" name="Order Process" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_order">
      <bpmn:lane id="Lane_order_default" name="default">
        <bpmn:flowNodeRef>Start_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_payment_latest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_fulfilment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rule_discount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_order</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_order" name="Order received">
      <bpmn:outgoing>Flow_order_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="Call_payment_latest" name="Take payment (latest)" calledElement="payment-process">
      <bpmn:incoming>Flow_order_1</bpmn:incoming>
      <bpmn:outgoing>Flow_order_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:subProcess id="SubProcess_fulfilment" name="Fulfilment">
      <bpmn:incoming>Flow_order_2</bpmn:incoming>
      <bpmn:outgoing>Flow_order_3</bpmn:outgoing>
      <bpmn:startEvent id="Start_fulfilment">
        <bpmn:outgoing>Flow_inner_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:callActivity id="Call_payment_pinned" name="Take payment (pinned)" calledElement="payment-process">
        <bpmn:extensionElements>
          <bfw:calledProcessVersion>1.0.0</bfw:calledProcessVersion>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_inner_1</bpmn:incoming>
        <bpmn:outgoing>Flow_inner_2</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:callActivity id="Call_archive_missing" name="Archive order" calledElement="archive-process">
        <bpmn:incoming>Flow_inner_2</bpmn:incoming>
        <bpmn:outgoing>Flow_inner_3</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:endEvent id="End_fulfilment">
        <bpmn:incoming>Flow_inner_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_inner_1" sourceRef="Start_fulfilment" targetRef="Call_payment_pinned" />
      <bpmn:sequenceFlow id="Flow_inner_2" sourceRef="Call_payment_pinned" targetRef="Call_archive_missing" />
      <bpmn:sequenceFlow id="Flow_inner_3" sourceRef="Call_archive_missing" targetRef="End_fulfilment" />
    </bpmn:subProcess>
    <bpmn:businessRuleTask id="Rule_discount" name="Apply discount" implementation="dmn">
      <bpmn:extensionElements>
        <bfw:decisionRef>discount-rules</bfw:decisionRef>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_order_3</bpmn:incoming>
      <bpmn:outgoing>Flow_order_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="End_order" name="Order done">
      <bpmn:incoming>Flow_order_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_order_1" sourceRef="Start_order" targetRef="Call_payment_latest" />
    <bpmn:sequenceFlow id="Flow_order_2" sourceRef="Call_payment_latest" targetRef="SubProcess_fulfilment" />
    <bpmn:sequenceFlow id="Flow_order_3" sourceRef="SubProcess_fulfilment" targetRef="Rule_discount" />
    <bpmn:sequenceFlow id="Flow_order_4" sourceRef="Rule_discount" targetRef="End_order" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_order">
    <bpmndi:BPMNPlane id="BPMNPlane_order" bpmnElement="Collaboration_order">
      <bpmndi:BPMNShape id="Participant_order_di" bpmnElement="Participant_order" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="1000" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_order_default_di" bpmnElement="Lane_order_default" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="970" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_order_di" bpmnElement="Start_order">
        <dc:Bounds x="172" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_payment_latest_di" bpmnElement="Call_payment_latest">
        <dc:Bounds x="260" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_fulfilment_di" bpmnElement="SubProcess_fulfilment" isExpanded="true">
        <dc:Bounds x="410" y="80" width="400" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_fulfilment_di" bpmnElement="Start_fulfilment">
        <dc:Bounds x="432" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_payment_pinned_di" bpmnElement="Call_payment_pinned">
        <dc:Bounds x="500" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_archive_missing_di" bpmnElement="Call_archive_missing">
        <dc:Bounds x="640" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_fulfilment_di" bpmnElement="End_fulfilment">
        <dc:Bounds x="762" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Rule_discount_di" bpmnElement="Rule_discount">
        <dc:Bounds x="860" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_order_di" bpmnElement="End_order">
        <dc:Bounds x="1012" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_order_1_di" bpmnElement="Flow_order_1">
        <di:waypoint x="208" y="200" />
        <di:waypoint x="260" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_order_2_di" bpmnElement="Flow_order_2">
        <di:waypoint x="360" y="200" />
        <di:waypoint x="410" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_inner_1_di" bpmnElement="Flow_inner_1">
        <di:waypoint x="468" y="200" />
        <di:waypoint x="500" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_inner_2_di" bpmnElement="Flow_inner_2">
        <di:waypoint x="600" y="200" />
        <di:waypoint x="640" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_inner_3_di" bpmnElement="Flow_inner_3">
        <di:waypoint x="740" y="200" />
        <di:waypoint x="762" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_order_3_di" bpmnElement="Flow_order_3">
        <di:waypoint x="810" y="200" />
        <di:waypoint x="860" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_order_4_di" bpmnElement="Flow_order_4">
        <di:waypoint x="960" y="200" />
        <di:waypoint x="1012" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
