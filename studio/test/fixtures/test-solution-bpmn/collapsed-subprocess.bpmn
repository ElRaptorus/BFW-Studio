      <bpmn:sequenceFlow id="Flow_SubInternal" sourceRef="SubStart_1" targetRef="Task_Inside" />
      <bpmn:sequenceFlow id="Flow_SubToEnd" sourceRef="Task_Inside" targetRef="SubEnd_1" />
    </bpmn:subProcess>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
