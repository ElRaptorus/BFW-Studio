    <bpmn:sequenceFlow id="Flow_ToSubprocess" sourceRef="StartEvent_1" targetRef="SubProcess_Collapsed" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="SubProcess_Collapsed" targetRef="EndEvent_1" />
  </bpmn:process>
