<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_AdHocSubprocess"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Bifrost Forge World"
                  exporterVersion="test-fixture">
  <bpmn:process id="Process_Main" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_ToAdHoc</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:adHocSubProcess id="AdHocSubProcess_1" name="Ad-hoc Sub-Process" ordering="Parallel" cancelRemainingInstances="true">
      <bpmn:incoming>Flow_ToAdHoc</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
      <bpmn:task id="AdHocTask_1" name="Ad-hoc Task 1" />
      <bpmn:task id="AdHocTask_2" name="Ad-hoc Task 2" />
    </bpmn:adHocSubProcess>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToAdHoc" sourceRef="StartEvent_1" targetRef="AdHocSubProcess_1" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="AdHocSubProcess_1" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Main">
    <bpmndi:BPMNPlane id="BPMNPlane_Main" bpmnElement="Process_Main">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="179" y="159" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="185" y="202" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AdHocSubProcess_1_di" bpmnElement="AdHocSubProcess_1" isExpanded="false">
        <dc:Bounds x="290" y="137" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="462" y="159" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="470" y="202" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToAdHoc_di" bpmnElement="Flow_ToAdHoc">
        <di:waypoint x="215" y="177" />
        <di:waypoint x="290" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="390" y="177" />
        <di:waypoint x="462" y="177" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_AdHocSubProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_AdHocSubProcess" bpmnElement="AdHocSubProcess_1">
      <bpmndi:BPMNShape id="AdHocTask_1_di" bpmnElement="AdHocTask_1">
        <dc:Bounds x="180" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AdHocTask_2_di" bpmnElement="AdHocTask_2">
        <dc:Bounds x="180" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
