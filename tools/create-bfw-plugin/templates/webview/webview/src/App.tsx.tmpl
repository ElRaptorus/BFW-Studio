import React, { useEffect, useState } from 'react';

/**
 * Iframe bridge shape. Same contract as `StudioWebviewApi` from `@elraptorus/bfw_studio_sdk`.
 * The host injects live `--theme-*` values (see `ThemeToken` in the SDK). Do not use
 * `--studio-color-*` — those are not forwarded into plugin iframes.
 */
type StudioThemeType = 'light' | 'dark';

type StudioWebviewApi = {
  postMessage(data: unknown): void;
  onMessage(callback: (data: unknown) => void): void;
  getState(): unknown;
  setState(state: unknown): void;
  getThemeType(): StudioThemeType;
};

declare global {
  interface Window {
    acquireStudioApi?(): StudioWebviewApi;
  }
}

export default function App(): React.JSX.Element {
  const [themeType, setThemeType] = useState<StudioThemeType>('dark');

  useEffect(() => {
    const api = window.acquireStudioApi?.();
    if (api) {
      setThemeType(api.getThemeType());
      api.postMessage({ type: 'ready' });
    }
  }, []);

  return (
    <div className="app">
      <h2>{{displayName}}</h2>
      <p className="app__meta">Theme: {themeType}</p>
      <p>
        Edit <code>webview/src/App.tsx</code> to build your UI. Host chrome widgets
        (Icon, Table, Checkbox, ColorPicker) are not in the SDK; style with{' '}
        <code>--theme-*</code> tokens, or import Feel / PaneProperty / FormInput from{' '}
        <code>@elraptorus/bfw_studio_sdk</code> if you add it to this webview package.
      </p>
    </div>
  );
}
