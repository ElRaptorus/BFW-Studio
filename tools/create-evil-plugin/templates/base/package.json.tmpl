        }
      ]
    }
  },
  "devDependencies": {
    "@evil/bifrost_fw_sdk": "^1.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0"
  }
}
