    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js --external:crypto",
    "dev": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js --external:crypto --watch"
