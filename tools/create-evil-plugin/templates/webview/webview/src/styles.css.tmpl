:root {
  color-scheme: dark light;
}

body {
  margin: 0;
  padding: 0;
  font-family: var(--studio-font-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
  font-size: var(--studio-font-size, 13px);
  color: var(--studio-color-text, #ccc);
  background: var(--studio-color-background, #1e1e1e);
}

code {
  font-family: var(--studio-font-family-mono, monospace);
  background: var(--studio-color-background-secondary, #2d2d2d);
  padding: 2px 4px;
  border-radius: 3px;
}
