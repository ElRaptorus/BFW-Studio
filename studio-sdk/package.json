{
  "name": "@elraptorus/bfw_studio_sdk",
  "version": "0.1.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "description": "The Bifrost Forge World SDK for plugin developers. Provides type definitions, reusable UI components, and design tokens for building Bifrost Forge World plugins.",
  "main": "./out/index.js",
  "typings": "./out/index.d.ts",
  "sideEffects": false,
  "files": [
    "out/**/*.{ts,js,css,scss}"
  ],
  "author": "ElRaptorus",
  "license": "MIT",
  "engines": {
    "node": ">=24.20.0",
    "npm": ">=12.0.0"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:ElRaptorus/BFW-Studio.git",
    "directory": "studio-sdk"
  },
  "scripts": {
    "clean": "node ./clean.js",
    "build": "npm run clean && tsc && node ./copy-assets.js",
    "format": "oxfmt -c ../.oxfmtrc.json src",
    "lint": "oxlint --report-unused-disable-directives src",
    "lint:fix": "oxlint --fix --report-unused-disable-directives src",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@bpmn-io/feel-editor": "^2.8.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-select": "^5.10.2"
  }
}
