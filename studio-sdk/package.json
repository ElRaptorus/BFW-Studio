{
  "name": "@evil/bifrost_fw_sdk",
  "version": "1.0.0",
  "description": "The Bifrost Forge World SDK for plugin developers. Provides type definitions, reusable UI components, and design tokens for building Bifrost Forge World plugins.",
  "main": "./out/index.js",
  "typings": "./out/index.d.ts",
  "private": true,
  "sideEffects": false,
  "files": [
    "out/**/*.{ts,js,css,scss}"
  ],
  "author": "ElRaptorus",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=12.0.0"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:ElRaptorus/EvilStudio.git",
    "directory": "studio-sdk"
  },
  "scripts": {
    "clean": "node ./clean.js",
    "build": "npm run clean && tsc && node ./copy-assets.js",
    "format": "prettier --write --config ../.prettierrc.json ./src",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "peerDependencies": {
    "@bpmn-io/feel-editor": "^2.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-select": "^5.10.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3"
  }
}
