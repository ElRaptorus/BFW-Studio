{
  "name": "@elraptorus/bfw_studio_sdk",
  "version": "0.1.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "description": "The Bifrost Forge World SDK for plugin developers. Provides type definitions, reusable UI components, and design tokens for building Bifrost Forge World plugins.",
  "main": "./out/index.js",
  "typings": "./out/index.d.ts",
  "sideEffects": false,
  "files": [
    "out/**/*.{ts,js,css,scss}"
  ],
  "author": "ElRaptorus",
  "license": "MIT",
  "engines": {
    "node": ">=24.20.0",
    "npm": ">=12.0.0"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:ElRaptorus/BFW-Studio.git",
    "directory": "studio-sdk"
  },
  "scripts": {
    "clean": "node ./clean.js",
    "build": "npm run clean && tsc && node ./copy-assets.js",
    "format": "prettier --write --config ../.prettierrc.json ./src",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint-react/eslint-plugin": "^5.20.5",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "peerDependencies": {
    "@bpmn-io/feel-editor": "^2.8.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-select": "^5.10.2"
  }
}
